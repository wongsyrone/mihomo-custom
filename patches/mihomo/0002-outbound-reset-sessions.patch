diff --git a/adapter/outbound/openvpn.go b/adapter/outbound/openvpn.go
index 3c7b1e6..712df46 100644
--- a/adapter/outbound/openvpn.go
+++ b/adapter/outbound/openvpn.go
@@ -233,6 +233,32 @@ func (o *OpenVPN) IsL3Protocol(metadata *C.Metadata) bool {
 	return true
 }
 
+// ResetSessions tears down the active OpenVPN tunnel without canceling runCtx so the next dial reconnects cleanly.
+func (o *OpenVPN) ResetSessions() {
+	if o == nil || o.runLock == nil {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 100*time.Millisecond)
+	err := o.runLock.Acquire(ctx, 1)
+	cancel()
+	if err != nil {
+		return
+	}
+	client := o.client
+	tunDevice := o.tunDevice
+	o.client = nil
+	o.tunDevice = nil
+	o.running = false
+	o.runLock.Release(1)
+
+	if client != nil {
+		_ = client.Close()
+	}
+	if tunDevice != nil {
+		_ = tunDevice.Close()
+	}
+}
+
 func (o *OpenVPN) Close() error {
 	if o.runCancel != nil {
 		o.runCancel()
