+// ResetSessions closes cached HTTP transports without preventing future GetTransport calls from creating new ones.
+func (m *ReuseManager) ResetSessions() {
+	if m == nil {
+		return
+	}
+	m.mu.Lock()
+	entries := m.entries
+	m.entries = nil
+	m.mu.Unlock()
+
+	for _, entry := range entries {
+		entry.close()
+	}
+}
